    "Reminders are on. They stay on this iPhone at 9:00 and are regular notifications, not Critical Alerts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are on. They stay on this iPhone at 9:00 and are regular notifications, not Critical Alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはオンです。このiPhoneの9:00に届く通常の通知で、重大な通知（Critical Alerts）ではありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒已開啟。會在這部 iPhone 的 9:00 送出，屬於一般通知，不是重大警示（Critical Alerts）。"
          }
        }
      }
    },
    "Reminders are off. Turn them on in iOS Settings. These are regular notifications, not Critical Alerts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are off. Turn them on in iOS Settings. These are regular notifications, not Critical Alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはオフです。iOSの設定でオンにしてください。通常の通知であり、重大な通知（Critical Alerts）ではありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒已關閉。請在 iOS 設定中開啟。這些是一般通知，不是重大警示（Critical Alerts）。"
          }
        }
      }
    },
