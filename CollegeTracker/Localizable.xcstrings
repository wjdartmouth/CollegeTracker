            "value": "關於"
          }
        }
      }
    },
    "College Tracker keeps your schools, deadlines, documents, and notes on this iPhone. There is no account, and the developer does not receive that store.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "College Tracker keeps your schools, deadlines, documents, and notes on this iPhone. There is no account, and the developer does not receive that store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進学トラッカーは、大学、締切、書類、メモをこのiPhoneに保存します。アカウントはなく、開発者はそのデータを受け取りません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升學追蹤把你的大學、截止日期、文件和筆記存在這部 iPhone。沒有帳戶，開發者不會收到這些資料。"
          }
        }
      }
    },
    "If iCloud is turned on for this app, the same store can sync to your private iCloud database. The developer does not read that database.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iCloud is turned on for this app, the same store can sync to your private iCloud database. The developer does not read that database."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリでiCloudをオンにすると、同じデータがあなた自身のプライベートiCloudデータベースに同期できます。開発者はそのデータベースを読みません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若為此 App 開啟 iCloud，同一份資料可以同步到你的私人 iCloud 資料庫。開發者不會讀取該資料庫。"
          }
        }
      }
    },
    "Deadline reminders are scheduled on this device. They are ordinary notifications, not Critical Alerts. Reminder text is not sent to the developer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadline reminders are scheduled on this device. They are ordinary notifications, not Critical Alerts. Reminder text is not sent to the developer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締切リマインダーはこの端末で予定されます。通常の通知であり、重大な通知（Critical Alerts）ではありません。リマインダーの文面は開発者に送られません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截止日期提醒在這部裝置上排程。它們是一般通知，不是重大警示（Critical Alerts）。提醒內容不會送給開發者。"
          }
        }
      }
    },
    "School names and pathway notes are bundled in the app. The app does not download a catalog and does not contact a College Tracker server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "School names and pathway notes are bundled in the app. The app does not download a catalog and does not contact a College Tracker server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大学名と出願経路の説明はアプリに同梱されています。カタログのダウンロードはせず、進学トラッカーのサーバーにも接続しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大學名稱和申請途徑說明已內建於 App。App 不會下載名錄，也不會連接升學追蹤的伺服器。"
          }
        }
      }
    },
    "Essay feedback is coming soon. This version does not send essay text off this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Essay feedback is coming soon. This version does not send essay text off this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッセイのフィードバックは近日公開です。このバージョンは、エッセイの本文をこのiPhoneの外へ送りません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作文回饋即將推出。此版本不會把作文文字送出這部 iPhone。"
          }
        }
      }
    },
    "The app does not track you, show ads, or sell personal data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not track you, show ads, or sell personal data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは、トラッキングを行わず、広告を表示せず、個人データを販売しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 不會追蹤你、不會顯示廣告，也不會出售個人資料。"
          }
        }
      }
    },
    "Questions go to the support link on the App Store page. This screen does not list a postal address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions go to the support link on the App Store page. This screen does not list a postal address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせは、App Storeページのサポートリンクからお願いします。この画面に住所は記載していません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如有問題，請使用 App Store 頁面的支援連結。此畫面不列出郵寄地址。"
          }
        }
      }
    },
