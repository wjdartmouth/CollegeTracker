    "Add a JUPAS, EJU, or other deadline from a school's Deadlines tab. Local reminders fire at 9:00 — 30 days, 1 week, 1 day, and the day of.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a JUPAS, EJU, or other deadline from a school's Deadlines tab. Local reminders fire at 9:00 — 30 days, 1 week, 1 day, and the day of."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大学の「締切」から、JUPAS・EJUなどの期限を追加できます。手元の通知は9:00に、30日前・1週間前・1日前・当日に届きます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在大學的「截止日期」分頁加入 JUPAS、EJU 或其他期限。本地提醒於 9:00 發出，分別在 30 日前、1 星期前、1 日前和當天。"
          }
        }
      }
    },
