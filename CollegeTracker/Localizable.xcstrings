    "Student–counselor CloudKit sharing is deferred for the first release. Existing counselor profiles can continue as a student to track applications locally.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Student–counselor CloudKit sharing is deferred for the first release. Existing counselor profiles can continue as a student to track applications locally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学生とカウンセラーのCloudKit共有は初回リリースでは後回しです。カウンセラー用のプロフィールがある場合は、学生としてこの端末で出願を管理できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學生與升學顧問的 CloudKit 分享不會納入首個版本。已有顧問身分的檔案可以改以學生身分，在這部裝置上記錄申請。"
          }
        }
      }
    },
    "Continue as student": {
