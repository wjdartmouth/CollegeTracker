    "Deadline reminders ask for permission the first time. They are regular local notifications at 9:00, not Critical Alerts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadline reminders ask for permission the first time. They are regular local notifications at 9:00, not Critical Alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締切リマインダーは、最初に許可を求めます。9:00の通常のローカル通知で、重大な通知（Critical Alerts）ではありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截止日期提醒會在第一次使用時要求許可。它們是 9:00 的一般本地通知，不是重大警示（Critical Alerts）。"
          }
        }
      }
    },
